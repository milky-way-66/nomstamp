        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem của họ rời khỏi bản đồ của bạn, và tem của bạn ngừng đến với họ. Những gì họ đã nhận vẫn nằm trên máy họ."

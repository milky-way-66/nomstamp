# Credentials for scripts/deploy.sh. Copy to .env and fill in — .env is gitignored and must
# never be committed. See docs/deployment/testflight.md §3.2.

# Your ten-character Team ID.
# developer.apple.com/account → Membership details
ASC_TEAM_ID=ABCDE12345

# App Store Connect API key, role App Manager.
# App Store Connect → Users and Access → Integrations → App Store Connect API → +
ASC_KEY_ID=XXXXXXXXXX

# The Issuer ID shown above the key list — one per account, shared by every key.
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The private key itself is a file, not a variable. It downloads once and once only; put it at
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# which is where the uploader looks. If you lose it, revoke the key and make another.
